# ============================================================
# CryptoTracker-specific ignores
# ============================================================

# ------------------------------------------------------------
# SECRET ENV FILES
# ------------------------------------------------------------

# Ignore all environment files by default
.env
.env.*

# BUT keep the non-secret config file in GitHub
!.env.config


# ------------------------------------------------------------
# API KEYS / CERTIFICATES / SECRETS
# ------------------------------------------------------------

*.key
*.pem
*.p12
*.pfx

secrets/
credentials/
private/


# ------------------------------------------------------------
# WALLET / PRIVATE CREDENTIAL FILES
# ------------------------------------------------------------

wallet*.json
*wallet_private*
*private_key*
*private-key*
*seed_phrase*
*seed-phrase*
*mnemonic*
*keystore*


# ------------------------------------------------------------
# SMART MONEY PRIVATE CONFIG
# ------------------------------------------------------------

# Keep monitored wallet list private
SmartMoneyMonitor/traders.json

# Optional template can still be committed
!SmartMoneyMonitor/traders.example.json


# ------------------------------------------------------------
# RUNTIME DATA / TRADING LOGS
# ------------------------------------------------------------

data/
logs/

SmartMoneyMonitor/data/

# Root-level runtime CSVs
trades_*.csv
smart_money_events_*.csv
smart_money_campaigns_*.csv
trader_performance_*.csv
wallet_scorecard_*.csv
surge_followup_log*.csv
confirmation_feed_log*.csv
ai_confirmation_log*.csv
reacceleration_watch_log*.csv
missed_opportunities_*.csv
holder_metrics_history*.csv

# JSON runtime state
state_*.json
position.json
holder_metrics_latest.json
reacceleration_watch*.json


# ------------------------------------------------------------
# DATABASES
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------
# TEMP / BACKUPS
# ------------------------------------------------------------

*.bak
*.tmp
*.temp
*.old
*.backup
~$*
*.swp


# ------------------------------------------------------------
# LOCAL OUTPUT / REPORT FILES
# ------------------------------------------------------------

reports/
analysis/daily/raw/
research/raw/


# ------------------------------------------------------------
# KEEP THESE TRACKED
# ------------------------------------------------------------

!.env.config
!README.md
!requirements.txt
!*.py
!*.bat