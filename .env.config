

# Pick a model available to your OpenAI API account.
OPENAI_MODEL=gpt-5.6-luna


# ============================================================
# CRYPTOTRACKER V11.8
# Multi-source discovery + reacceleration watch + false-negative review
# Quant-first model with Smart Money, Token Social,
# execution integrity, runner protection and dual Pushover routing
# GPT-5.6 Luna momentum-pattern confirmation
# Daily objective: +2% target / lock concept (not guaranteed)
# ============================================================

# IMPORTANT
# - This is the FULL replacement for your SETTINGS block.
# - Keep your existing SECRET/API section unchanged:
#     JUPITER_API_KEY
#     BOT_PRIVATE_KEY / wallet secrets
#     HELIUS_API_KEY
#     OPENAI_API_KEY
#     X_BEARER_TOKEN
#     PUSHOVER_API_TOKEN
#     PUSHOVER_USER_KEY
#     PUSHOVER_CRYPTO_MOVEMENT_GROUP_KEY
#     PUSHOVER_CRYPTO_EOD_TOKEN
#     PUSHOVER_CRYPTO_EOD_GROUP_KEY
# - Keep only ONE copy of each variable in the final .env.
# - Birdeye is intentionally disabled; no paid Birdeye subscription is needed.


# ============================================================
# PUSHOVER / EOD PERFORMANCE
# ============================================================

PUSHOVER_CRYPTO_EOD_ENABLED=1

# 11:00 PM Pacific.
CRYPTO_EOD_TIMEZONE=America/Los_Angeles
PUSHOVER_CRYPTO_EOD_HOUR=23
PUSHOVER_CRYPTO_EOD_MINUTE=00

# Routing is handled by your existing secret keys:
# SURGE / BUY / SELL -> PUSHOVER_CRYPTO_MOVEMENT_GROUP_KEY
# EOD               -> PUSHOVER_CRYPTO_EOD_GROUP_KEY
# V11.8: if PUSHOVER_CRYPTO_EOD_TOKEN is missing, EOD falls back to
#        PUSHOVER_API_TOKEN instead of silently disabling the report.
# private/system    -> PUSHOVER_USER_KEY


# ============================================================
# LIVE TRADING
# ============================================================

LIVE_TRADING=true

# NORMAL trades use full size.
# EARLY_ACCEL trades are smaller probes.
TRADE_SIZE_USDC=1.50
NORMAL_TRADE_SIZE_USDC=1.50
EARLY_ACCEL_TRADE_SIZE_USDC=0.75

# Keep dynamic risk-based sizing OFF while V11.7 is validated.
USE_RISK_BASED_SIZING=0

NORMAL_RISK_PCT=0.50
EARLY_RISK_PCT=0.25

MIN_TRADE_SIZE_USDC=0.50
MAX_TRADE_SIZE_USDC=3.00
MAX_POSITION_PCT_EQUITY=15.0

# Confirmations may increase a QUALIFIED position, but cannot rescue
# a failed quant setup.
CONFIRMATION_SIZE_BOOST_MAX_PCT=25.0

# Negative social sentiment can reduce trade size.
NEGATIVE_SOCIAL_SIZE_REDUCTION_PCT=25.0


# ============================================================
# DAILY ACCOUNT CONTROLS
# ============================================================

# +2% is the daily profit objective.
# Entry standards are NOT relaxed to reach this number.
DAILY_TARGET_PCT=2.0

# Preserving your current setting.
DAILY_TARGET_LOCK_ENABLED=0

# Buffer used only if the daily target lock is enabled later.
DAILY_TARGET_LOCK_BUFFER_PCT=0.25

# Preserving your current setting.
MAX_DAILY_DRAWDOWN_PCT=7

# 0 = use live wallet/account value as the daily baseline.
DAILY_REFERENCE_CAPITAL_USDC=0

# Preserving your current setting.
MAX_TRADES_PER_DAY=14

# Secondary absolute loss backstop.
DAILY_REALIZED_LOSS_LIMIT_USD=3.00


# ============================================================
# NORMAL QUANT ENTRY PATH
# ============================================================

# Quant remains the PRIMARY decision maker.
MIN_BUY_SCORE=80
# V11.8 historical replay: delta 20 captured more/better NORMAL setups than 35.
MIN_BUY_SCORE_DELTA=20

MIN_BUY_LIQUIDITY=40000
MIN_BUY_5M_VOLUME=2000
MIN_BUY_VOLUME_ACCEL=1.50
MIN_BUY_SELL_RATIO=1.20
MIN_5M_TRANSACTIONS=15

# Anti-chase price window.
MIN_BUY_5M_PCT=1.0
MAX_BUY_5M_PCT=15.0

MIN_BUY_1H_PCT=-10.0
MAX_BUY_1H_PCT=40.0


# ============================================================
# EARLY_ACCEL ENTRY PATH
# ============================================================

# Smaller probe position. Lower absolute activity is allowed only
# with stronger acceleration, flow and tighter anti-chase behavior.
EARLY_ACCEL_MIN_SCORE=60
EARLY_ACCEL_MIN_SCORE_DELTA=35

EARLY_ACCEL_MIN_LIQUIDITY=50000
EARLY_ACCEL_MIN_5M_VOLUME=750
EARLY_ACCEL_MIN_VOLUME_ACCEL=2.50
EARLY_ACCEL_MIN_BUY_SELL_RATIO=1.40
EARLY_ACCEL_MIN_5M_TRANSACTIONS=15

# V11.8: EARLY setups must persist across multiple one-minute scans.
EARLY_CONFIRM_MIN_POINTS=3
EARLY_CONFIRM_MIN_POSITIVE_FLOW_POINTS=2
EARLY_CONFIRM_MIN_RISING_SCORE_POINTS=1

EARLY_ACCEL_MIN_5M_PCT=1.0
EARLY_ACCEL_MAX_5M_PCT=10.0

EARLY_ACCEL_MIN_1H_PCT=-10.0
EARLY_ACCEL_MAX_1H_PCT=30.0


# ============================================================
# EXECUTION INTEGRITY
# ============================================================

# Minimum acceptable Jupiter buy -> immediate sell-back value.
MIN_ROUNDTRIP_RETURN_PCT=97.0
NORMAL_MIN_ROUNDTRIP_RETURN_PCT=97.0
EARLY_MIN_ROUNDTRIP_RETURN_PCT=98.5

EXECUTION_INTEGRITY_ENABLED=1

# Cross-check DEX Screener pricing against GeckoTerminal.
GECKOTERMINAL_ENABLED=1

# External comparison data is helpful, but a temporary API failure
# does not automatically disable trading.
EXEC_REQUIRE_GECKO_PRICE=0
EXEC_REQUIRE_JUPITER_PRICE_CONSENSUS=0

EXEC_MAX_DEX_GECKO_DIVERGENCE_PCT=3.0
EXEC_MAX_JUPITER_CONSENSUS_DIVERGENCE_PCT=3.0

# Treat suspiciously favorable round-trip quotes as bad data too.
EXEC_MAX_ROUNDTRIP_RETURN_PCT=100.5

EXEC_ROUNDTRIP_SAMPLES=2
EXEC_ROUNDTRIP_SAMPLE_DELAY_SECONDS=2.0
EXEC_MAX_ROUNDTRIP_SAMPLE_SPREAD_PCT=2.0





# ============================================================
# BIRDEYE SMART MONEY
# ============================================================

# OFF intentionally. Your free Birdeye tier does not include the
# Smart Money endpoint and we are not paying for it at this stage.
BIRDEYE_SMART_MONEY_ENABLED=0

BIRDEYE_SMART_MONEY_REFRESH_SECONDS=300
BIRDEYE_SMART_MONEY_INTERVAL=1d
BIRDEYE_SMART_MONEY_TRADER_STYLE=trenchers
BIRDEYE_SMART_MONEY_MAX_BONUS=15
BIRDEYE_SMART_MONEY_MAX_PENALTY=10
BIRDEYE_MIN_SMART_TRADERS=2


# ============================================================
# 13-INFLUENCER MACRO SOCIAL MONITOR — DISABLED
# ============================================================

SOCIAL_SENTIMENT_ENABLED=0

# Disabled to eliminate continuous 13-influencer X API polling.
# Do NOT run social_sentiment_monitor_v2_efficient.py while this is 0.
# Historical social files can remain in data/; V11.8 ignores them.
# Macro social weights are retained below only for easy future testing.
SOCIAL_SCORE_WEIGHT=0.15
SOCIAL_MAX_BONUS=15
SOCIAL_ECOSYSTEM_MULTIPLIER=0.25
SOCIAL_MAX_AGE_MINUTES=15


# ============================================================
# SOCIAL MONITOR POLLING
# ============================================================

SOCIAL_POLL_SECONDS=300
SOCIAL_LOOKBACK_MINUTES=180
SOCIAL_SCORE_HALF_LIFE_MINUTES=90
SOCIAL_BOOTSTRAP_LATEST=true


# ============================================================
# TOKEN-SPECIFIC X SOCIAL MOMENTUM
# ============================================================

TOKEN_SOCIAL_ENABLED=1

# Only search the best quant candidates.
TOKEN_SOCIAL_TOP_N=2
TOKEN_SOCIAL_LOOKBACK_MINUTES=30
TOKEN_SOCIAL_CACHE_SECONDS=300
# V11.8: X text still goes to Luna, but direct X score influence is disabled.
TOKEN_SOCIAL_MAX_BONUS=0
TOKEN_SOCIAL_MIN_UNIQUE_AUTHORS=2

# Audit actual targeted X API calls so we can measure daily paid usage.
X_API_USAGE_LOG_ENABLED=1


# ============================================================
# SURGING / MOVEMENT PUSHOVER ALERTS
# ============================================================

SURGE_PUSH_ENABLED=1
SURGE_PUSH_COOLDOWN_MINUTES=10


# ============================================================
# STOP LOSS / EXIT LOGIC
# ============================================================

# Ignore ordinary momentum deterioration during the first 10 minutes.
# Emergency and confirmed-loss protection remain active.
MOMENTUM_EXIT_GRACE_MINUTES=10

STOP_LOSS_PCT=-6
EMERGENCY_STOP_PCT=-12
STOP_CONFIRMATIONS_REQUIRED=2

# Score/delta deterioration alone cannot close a trade.
SOFT_EXIT_REQUIRE_MC_CONFIRMATION=1

EXIT_SCORE_BELOW=35
EXIT_SCORE_DELTA_BELOW=-20


# ============================================================
# 15-MINUTE STAGNATION CHECK
# ============================================================

STAGNANT_EXIT_MINUTES=15
STAGNANT_EXIT_MAX_PNL_PCT=3.0


# ============================================================
# RUNNER LOGIC
# ============================================================

RUNNER_ACTIVATE_PCT=10

RUNNER_DRAWDOWN_10_25_PCT=8
RUNNER_DRAWDOWN_25_50_PCT=10
RUNNER_DRAWDOWN_50_PLUS_PCT=15

# Profit floors after a runner has achieved stronger peaks.
RUNNER_PROFIT_FLOOR_10_PCT=4
RUNNER_PROFIT_FLOOR_20_PCT=10
RUNNER_PROFIT_FLOOR_30_PCT=15
RUNNER_PROFIT_FLOOR_50_PCT=25

RUNNER_FLOOR_CONFIRMATIONS_REQUIRED=2

# Protect a useful +6% move before it reaches full RUNNER mode.
PRE_RUNNER_PROTECT_ACTIVATE_PCT=6
PRE_RUNNER_PROFIT_FLOOR_PCT=2
PRE_RUNNER_FLOOR_CONFIRMATIONS_REQUIRED=2


# ============================================================
# HOLD TIMES / MARKET CAP
# ============================================================

MAX_HOLD_MINUTES=30
EXTENDED_HOLD_MAX_MINUTES=60
EXTENDED_HOLD_MIN_PNL_PCT=-1.0
EXTENDED_HOLD_MIN_SCORE=60
EXTENDED_HOLD_MIN_BUY_SELL_RATIO=1.10
RUNNER_MAX_HOLD_MINUTES=120
MC_ROLLING_WINDOW_MINUTES=5


# ============================================================
# RE-ENTRY / OVERTRADING PROTECTION
# ============================================================

COOLDOWN_MINUTES=20
ALLOW_STRONG_REENTRY=1

MAX_ENTRIES_PER_TOKEN_60M=1

REENTRY_MIN_SCORE=120
REENTRY_MIN_SCORE_DELTA=35

REENTRY_MIN_LIQUIDITY=75000
REENTRY_MIN_5M_VOLUME=10000
REENTRY_MIN_VOLUME_ACCEL=1.75
REENTRY_MIN_BUY_SELL_RATIO=1.75
REENTRY_MIN_5M_TRANSACTIONS=15

REENTRY_MIN_5M_PCT=2.0
REENTRY_MAX_5M_PCT=15.0

REENTRY_MIN_1H_PCT=10.0
REENTRY_MAX_1H_PCT=30.0


# ============================================================
# SCANNER / RESEARCH
# ============================================================

SCAN_INTERVAL_SECONDS=60

# Continue watching tokens after they disappear from newest /
# boosted DEX Screener feeds.
PERSISTENT_WATCH_HOURS=2.0
UNIVERSE_RETENTION_HOURS=24.0

# Forward-outcome collection for accepted AND rejected SURGING signals.
SURGE_FOLLOWUP_ENABLED=1
# SHADOW-only audit trail for candidate/path/dedupe/30m/60m/120m outcomes.
SURGE_FOLLOWUP_AUDIT_ENABLED=1
SURGE_SIGNAL_DEDUPE_MINUTES=10
SURGE_FOLLOWUP_MAX_MINUTES=120
SURGE_FOLLOWUP_POLL_MINUTES=2


# ============================================================
# CONFIRMATION FEED AUDIT
# ============================================================

CONFIRMATION_FEED_LOG_ENABLED=1
CONFIRMATION_FEED_SURGING_ONLY=1
CONFIRMATION_FEED_DEDUPE_MINUTES=5


# ============================================================
# MULTI-SOURCE DISCOVERY
# ============================================================

# Broadens what gets EVALUATED. It does not bypass the quant gates.
MULTISOURCE_DISCOVERY_ENABLED=1

# Fresh VERIFIED SmartMoneyMonitor Solana buys can inject a mint
# directly into the scanner universe.
WHALE_DISCOVERY_ENABLED=1
WHALE_DISCOVERY_MAX_AGE_MINUTES=60
WHALE_DISCOVERY_MIN_SPEND_USD=50
WHALE_DISCOVERY_MAX_TOKENS=30

# Free GeckoTerminal new-pool discovery.
GECKO_DISCOVERY_ENABLED=1
GECKO_DISCOVERY_REFRESH_SECONDS=300
GECKO_DISCOVERY_MAX_TOKENS=25


# ============================================================
# REACCELERATION WATCH
# ============================================================

# High-quality tokens rejected for 5m/1h over-extension are watched,
# not chased. They only become REACCEL READY if they later reset and
# independently pass the EXISTING NORMAL or EARLY_ACCEL rules.
REACCEL_WATCH_ENABLED=1
REACCEL_WATCH_MAX_AGE_MINUTES=120

# Minimum quality before an extended token is put on watch.
REACCEL_WATCH_MIN_SCORE=60
REACCEL_WATCH_MIN_DELTA=35
REACCEL_WATCH_MIN_LIQUIDITY=40000
REACCEL_WATCH_MIN_5M_VOLUME=750
REACCEL_WATCH_MIN_VOLUME_ACCEL=1.50
REACCEL_WATCH_MIN_BUY_SELL_RATIO=1.10
REACCEL_WATCH_MIN_5M_TRANSACTIONS=8

# V11.8: keep studying reacceleration, but do not give it a ranking bonus.
REACCEL_PRIORITY_BONUS=0
REACCEL_PUSH_ENABLED=1


# ============================================================
# NIGHTLY FALSE-NEGATIVE REVIEW
# ============================================================

MISSED_OPPORTUNITY_REPORT_ENABLED=1

# Flag rejected token-days that later achieved these MFE levels.
MISSED_OPPORTUNITY_MIN_30M_MFE_PCT=20
MISSED_OPPORTUNITY_MIN_60M_MFE_PCT=50


# ============================================================
# X COST CONTROL
# ============================================================

# The separate 13-influencer monitor should NOT be running.
# V11.8 uses X only for on-demand Token-X searches after Quant identifies
# a top candidate. Cached lookups do not count as new X API requests.
#
# Audit file created automatically:
# data/x_api_usage_log.csv
#
# Crypto EOD reports:
# Targeted X: <requests> req | <signal hits> | <unique tokens>


# ============================================================
# GPT-5.6 LUNA MOMENTUM ANALYST — V11.8
# ============================================================

# Luna only reviews quant-valid SURGING candidates.
AI_CONFIRMATION_ENABLED=1
AI_CONFIRMATION_TOP_N=2

# Avoid repeat API calls for the same token inside 5 minutes.
AI_CONFIRMATION_CACHE_SECONDS=300

# Keep Luna bounded while we measure predictive value.
# Luna can change ranking/composite only; it cannot bypass quant gates.
AI_CONFIRMATION_MAX_BONUS=5
AI_HEALTHY_SURGE_MAX_BONUS=8
DELTA_RANK_MAX_BONUS=5

# Confidence -> deterministic code adjustment:
# 60-79% = +/-3
# 80-100% = +/-5
# <60% = 0
AI_CONFIRMATION_MIN_CONFIDENCE=60
AI_CONFIRMATION_HIGH_CONFIDENCE=80

# V11.8: low reasoning for trajectory + multi-signal analysis.
AI_CONFIRMATION_REASONING_EFFORT=1

# Keep the nightly observation-only research lesson.
AI_EOD_REVIEW_ENABLED=1


# ============================================================
# OUTPUT FILES — CREATED AUTOMATICALLY
# ============================================================

# data/discovery_source_log.csv
# data/reacceleration_watch_v115.json
# data/reacceleration_watch_log.csv
# data/missed_opportunities_YYYY-MM-DD.csv
# data/surge_followup_log.csv
# data/confirmation_feed_log.csv
# data/trades_YYYY-MM-DD.csv
# data/x_api_usage_log.csv
# data/ai_confirmation_log.csv

# ============================================================
# SMART MONEY MONITOR V2.2 — CAMPAIGN STRENGTH
# Add these to your existing CryptoTracker .env
# ============================================================

# Existing classifications remain:
SMART_MONEY_MICRO_BUY_USD=50
SMART_MONEY_MEANINGFUL_BUY_USD=500
SMART_MONEY_STRONG_BUY_USD=2000
SMART_MONEY_VERY_STRONG_BUY_USD=5000

# Smallest buy that can refresh a campaign's actionable signal age.
# Micro buys below this remain visible but do NOT make an old campaign fresh.
SMART_MONEY_SIGNAL_MIN_BUY_USD=100

# Reward repeated meaningful accumulation when buys cluster in time.
SMART_MONEY_ACCUMULATION_WINDOW_MINUTES=15

# Window for detecting independent tracked wallets accumulating the same mint.
SMART_MONEY_CONVERGENCE_WINDOW_MINUTES=15

# Per-wallet campaign score cap. CryptoTracker still applies its global
# SMART_MONEY_MAX_BONUS cap after combining wallets.
SMART_MONEY_CAMPAIGN_STRENGTH_MAX=25

# Safety only. Exact-mint/base-token sampling is the primary v2.2 price fix.
# Samples beyond this absolute return are marked ANOMALY rather than learned from.
SMART_MONEY_SAMPLE_SANITY_MAX_ABS_RETURN_PCT=10000

# Existing polling values may remain unchanged:
SMART_MONEY_POLL_SECONDS=15
SMART_MONEY_HELIUS_LIMIT=20
SMART_MONEY_CAMPAIGN_RESET_MINUTES=60

# ============================================================
# LOCAL SMART MONEY / WHALE CONFIRMATION
# ============================================================

SMART_MONEY_ENABLED=1
SMART_MONEY_MAX_AGE_MINUTES=15

SMART_MONEY_MAX_BONUS=25
SMART_MONEY_MULTI_WHALE_BONUS=10

# Fresh meaningful/large buying matters more than repeated accumulation.
SMART_MONEY_ACCUMULATION_BONUS=0


# ============================================================
# DAILY AGENTIC MODEL REVIEW — NON-SECRET SETTINGS
# Put these in .env.config
# ============================================================

DAILY_REVIEW_MODEL=gpt-5.6-sol
DAILY_REVIEW_MIN_PROPOSAL_SAMPLES=12
DAILY_REVIEW_PUSHOVER_ENABLED=1

# ============================================================
# AGENTIC DEPLOYMENT — NON-SECRET SETTINGS (.env.config)
# ============================================================

DEPLOYMENT_AGENT_ENABLED=1
DEPLOYMENT_AGENT_POLL_SECONDS=60

# Remote deployment startup
# 0 = trader starts LIVE automatically after deployment/restart
# 1 = require typing START LIVE
REQUIRE_START_LIVE_CONFIRMATION=0


# Hard cap for tokens scanned each cycle (also bounded by scanner module cap).
MAX_ACTIVE_SCAN_TOKENS=100


# Cache wallet USDC balance to avoid one Helius RPC read every cycle.
WALLET_BALANCE_CACHE_SECONDS=300


# Helius transient throttle/server retry policy.
HELIUS_MAX_RETRIES=3


# Initial Helius retry delay.
HELIUS_BACKOFF_BASE_SECONDS=1.0


# Maximum Helius retry delay.
HELIUS_BACKOFF_MAX_SECONDS=8.0
